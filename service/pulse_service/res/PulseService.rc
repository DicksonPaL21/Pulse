// File version information for PulseService.exe: shown in its Properties
// dialog and checked by code signing (product name and version).
#include <winver.h>

#include "pulse/product.h"

#define PULSE_VERSION_NUMBER \
  PULSE_VERSION_MAJOR, PULSE_VERSION_MINOR, PULSE_VERSION_PATCH, 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PULSE_VERSION_NUMBER
 PRODUCTVERSION PULSE_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Regn Creative" "\0"
            VALUE "FileDescription", PULSE_SERVICE_DISPLAY_NAME "\0"
            VALUE "FileVersion", PULSE_VERSION_STRING "\0"
            VALUE "InternalName", "PulseService" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Regn Creative. All rights reserved." "\0"
            VALUE "OriginalFilename", "PulseService.exe" "\0"
            VALUE "ProductName", PULSE_PRODUCT_NAME "\0"
            VALUE "ProductVersion", PULSE_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
